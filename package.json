{
  "name": "self-learning-marketing-os",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:control": "vite --config frontend/platform-admin/vite.config.ts",
    "build:customer": "tsc -b && vite build",
    "build:control": "tsc -p frontend/platform-admin/tsconfig.json --noEmit && vite build --config frontend/platform-admin/vite.config.ts",
    "build": "npm run build:customer && npm run build:control",
    "preview": "vite preview",
    "preview:control": "vite preview --config frontend/platform-admin/vite.config.ts",
    "typecheck": "tsc -b --pretty false && tsc -p frontend/platform-admin/tsconfig.json --noEmit --pretty false",
    "architecture:check": "node scripts/check-route-registry.mjs",
    "budget:check": "node scripts/check-frontend-budgets.mjs",
    "check": "npm run architecture:check && npm run typecheck",
    "verify": "npm run architecture:check && npm run build && npm run budget:check"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@tanstack/react-query": "^5.62.7",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^6.28.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
