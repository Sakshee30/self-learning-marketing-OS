DATABASE_URL=postgres://growthos:change-me@localhost:5432/growthos_website
HOST=0.0.0.0
PORT=3002
DATABASE_POOL_MAX=10
WEBSITE_ORIGINS=http://localhost:3000

# Authenticates the CMS/publishing pipeline when synchronizing published form versions.
# Use a long random secret in real environments and keep the same value out of client-side code.
CMS_SYNC_TOKEN=change-me-with-a-long-random-service-token

# Delivery worker. Use an approved internal/provider endpoint in real environments.
DELIVERY_WEBHOOK_URL=https://example.invalid/growthos-events
DELIVERY_WEBHOOK_BEARER_TOKEN=
DELIVERY_POLL_INTERVAL_MS=1000
DELIVERY_REQUEST_TIMEOUT_MS=10000
DELIVERY_LEASE_MS=60000
DELIVERY_MAX_ATTEMPTS=8
DELIVERY_RETRY_BASE_MS=30000
DELIVERY_RETRY_MAX_MS=3600000
